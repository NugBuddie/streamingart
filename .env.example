# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one guild (instant) instead of globally (up to 1h)
DISCORD_GUILD_ID=

# --- Storage ---
DB_PATH=./data/void.db

# --- Web ---
WEB_PORT=3000
# Set to 1 to allow name-only registration from the browser (local development ONLY)
WEB_DEV_LOGIN=0

# --- World ticker ---
TICK_SECONDS=5

# --- Mission length ---
# seconds = TEST MODE: missions take 5 / 15 / 30 SECONDS. Set to minutes for the real game pace (5 / 15 / 30 MINUTES).
MISSION_TIME_UNIT=seconds

# Log verbosity: error | warn | info (default: every action that changes the game) | debug (also read-only commands)
LOG_LEVEL=info
